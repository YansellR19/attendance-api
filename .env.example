# Base de datos PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/attendance_db
DB_USERNAME=attendance_user
DB_PASSWORD=attendance_pass

# Seguridad JWT (minimo 32 caracteres en produccion)
JWT_SECRET=ChangeThisSecretKeyToAStrongRandomValueAtLeast32CharsLong2026!
JWT_EXPIRATION_MS=86400000

# Configuracion de negocio
APP_TIMEZONE=America/Santo_Domingo
APP_SEED_ENABLED=true
APP_SEED_DEMO_ATTENDANCE=true
